{
  "name": "bookends-cleaning",
  "version": "1.0.0",
  "private": true,
  "description": "Bookends Kitchen Operations & Compliance — Express API + static PWA (Vercel, Render or any Node host)",
  "main": "server/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "create-user": "node server/scripts/createUser.js",
    "set-superadmin": "node server/scripts/setSuperadmin.js",
    "set-all-passwords": "node server/scripts/setAllPasswords.js",
    "reset-superadmin": "node server/scripts/resetSuperadmin.js",
    "db:start": "node server/scripts/db.js start",
    "db:stop": "node server/scripts/db.js stop",
    "db:status": "node server/scripts/db.js status",
    "db:restart": "node server/scripts/db.js restart",
    "build": "node scripts/build.js",
    "vercel:headers": "node scripts/build.js --print",
    "import:supabase": "node server/scripts/importSupabase.js",
    "copy-db": "node server/scripts/copyDatabase.js",
    "photos-to-blob": "node server/scripts/photosToBlob.js",
    "test": "node --test \"server/tests/*.test.js\""
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.8",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
